<UserControl
    x:Class="PodTiendita.Views.HistorialView"
    x:Name="vista"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PodTiendita.ViewModels"
    xmlns:ctl="clr-namespace:PodTiendita.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30">

            <!-- Título + descarga -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Historial de ventas" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PosDark}"/>
                    <TextBlock Text="Consulta todas las ventas realizadas" FontSize="12"
                               Foreground="{StaticResource PosMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource OutlineAccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding DescargarPdfCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Descargar PDF" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filtros -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Hoy" GroupName="periodo" IsChecked="True" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarPeriodoCommand}" CommandParameter="Hoy"/>
                        <RadioButton Content="Ayer" GroupName="periodo" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarPeriodoCommand}" CommandParameter="Ayer"/>
                        <RadioButton Content="Esta semana" GroupName="periodo" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarPeriodoCommand}" CommandParameter="EstaSemana"/>
                        <RadioButton Content="Este mes" GroupName="periodo" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarPeriodoCommand}" CommandParameter="EsteMes"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="0" Height="38" VerticalAlignment="Bottom"
                                BorderBrush="{StaticResource PosBorder}" BorderThickness="1">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{StaticResource PosMuted}"
                                               HorizontalAlignment="Left" Margin="12,0,0,0"/>
                                <TextBox x:Name="txtBuscar" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center" Margin="38,0,12,0" FontSize="12"
                                         Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Buscar por folio o cajero..." IsHitTestVisible="False"
                                           Foreground="{StaticResource PosMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="42,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="170">
                            <TextBlock Text="Método de pago" Style="{StaticResource HeaderCell}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{x:Static vm:HistorialViewModel.MetodosPago}"
                                      SelectedItem="{Binding MetodoFiltro}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Width="170">
                            <TextBlock Text="Estado" Style="{StaticResource HeaderCell}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{x:Static vm:HistorialViewModel.Estados}"
                                      SelectedItem="{Binding EstadoFiltro}" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Limpiar" Style="{StaticResource GhostButton}" FontSize="12"
                                Foreground="{StaticResource PosMuted}" VerticalAlignment="Bottom" Margin="8,0,0,6"
                                Padding="10,4" Command="{Binding LimpiarFiltrosCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Indicadores -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding EtiquetaVentas}" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Text="{Binding NumVentas}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,6,0,2"/>
                        <TextBlock Text="pagadas, sin contar canceladas" FontSize="10" Foreground="{StaticResource PosMuted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Total vendido" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Text="{Binding TotalVendido, StringFormat={}{0:C2}}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,6,0,2"/>
                        <TextBlock Text="MXN" FontSize="10" Foreground="{StaticResource PosMuted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ticket promedio" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Text="{Binding TicketPromedio, StringFormat={}{0:C2}}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,6,0,2"/>
                        <TextBlock Text="MXN por venta" FontSize="10" Foreground="{StaticResource PosMuted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tabla -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FOLIO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="HORA" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="CAJERO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="MÉTODO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="5" Text="ESTADO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="6" Text="ACCIONES" Style="{StaticResource HeaderCell}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource PosBorder}"/>

                    <TextBlock Text="No hay ventas con estos filtros." FontSize="12" Foreground="{StaticResource PosMuted}"
                               HorizontalAlignment="Center" Margin="0,28"
                               Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}"/>

                    <ItemsControl ItemsSource="{Binding Filas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1">
                                    <Grid Margin="20,0" Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Folio}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Hora}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Cajero}" Style="{StaticResource Cell}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Metodo}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:C2}}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>

                                        <!-- Estado -->
                                        <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="0" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E7F1E8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsCancelada}" Value="True">
                                                            <Setter Property="Background" Value="#F8E4E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{StaticResource PosOk}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsCancelada}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource PosDanger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PosOk}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsCancelada}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PosDanger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Padding="6" ToolTip="Ver detalle"
                                                    Command="{Binding DataContext.VerDetalleCommand, ElementName=vista}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Eye24" FontSize="18"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="6" ToolTip="Cancelar venta"
                                                    Visibility="{Binding PuedeCancelar, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.CancelarVentaCommand, ElementName=vista}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="18"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ResumenTabla}" FontSize="11" Foreground="{StaticResource PosMuted}"
                               Margin="20,14"/>
                </StackPanel>
            </Border>

            <!-- Gráfica de pastel -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding TituloGrafica}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PosDark}"/>
                    <TextBlock Text="Cuánto aportó cada producto al total vendido" FontSize="11"
                               Foreground="{StaticResource PosMuted}" Margin="0,2,0,16"/>

                    <TextBlock Text="Aún no hay ventas pagadas en este periodo." FontSize="12"
                               Foreground="{StaticResource PosMuted}" Margin="0,24"
                               HorizontalAlignment="Center"
                               Visibility="{Binding NoHayRebanadas, Converter={StaticResource BoolVis}}"/>

                    <Grid Visibility="{Binding HayRebanadas, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ctl:PieChart Grid.Column="0" Width="220" Height="220"
                                      Rebanadas="{Binding Rebanadas}"
                                      TextoCentral="{Binding TotalCentral}" SubtextoCentral="vendido"/>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Rebanadas}" Margin="40,0,0,0"
                                      VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" CornerRadius="0" Background="{Binding ColorHex}"
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Etiqueta}" Style="{StaticResource Cell}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Monto, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Porcentaje, StringFormat={}{0:0.#}%}"
                                                   Style="{StaticResource Cell}" Foreground="{StaticResource PosMuted}"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
