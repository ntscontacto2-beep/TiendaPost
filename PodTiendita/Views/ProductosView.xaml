<UserControl
    x:Class="PodTiendita.Views.ProductosView"
    x:Name="vista"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30">

            <!-- Título + nuevo producto -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Productos" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PosDark}"/>
                    <TextBlock Text="Administra tu catálogo y precios" FontSize="12"
                               Foreground="{StaticResource PosMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="0" Command="{Binding NuevoCommand}"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo producto" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Búsqueda y filtros -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#F5F7FA" Height="40" BorderBrush="{StaticResource PosBorder}" BorderThickness="1"
                            Margin="0,0,20,0">
                        <Grid>
                            <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{StaticResource PosMuted}"
                                           HorizontalAlignment="Left" Margin="12,0,0,0"/>
                            <TextBox x:Name="txtBuscar" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" Margin="38,0,12,0" FontSize="13"
                                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Buscar por nombre o categoría..." IsHitTestVisible="False"
                                       Foreground="{StaticResource PosMuted}" FontSize="13"
                                       VerticalAlignment="Center" Margin="42,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="Todos" GroupName="filtro" IsChecked="True" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarFiltroCommand}" CommandParameter="Todos"/>
                        <RadioButton Content="Disponibles" GroupName="filtro" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarFiltroCommand}" CommandParameter="Disponibles"/>
                        <RadioButton Content="Stock bajo" GroupName="filtro" Style="{StaticResource PillButton}"
                                     Command="{Binding SeleccionarFiltroCommand}" CommandParameter="BajoStock"/>
                        <RadioButton Content="Agotados" GroupName="filtro" Style="{StaticResource PillButton}" Margin="0"
                                     Command="{Binding SeleccionarFiltroCommand}" CommandParameter="Agotados"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabla -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCTO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="PRECIO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="EXISTENCIA" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="4" Text="ESTADO" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="5" Text="ACCIONES" Style="{StaticResource HeaderCell}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource PosBorder}"/>

                    <TextBlock Text="No hay productos con estos filtros." FontSize="12" Foreground="{StaticResource PosMuted}"
                               HorizontalAlignment="Center" Margin="0,28"
                               Visibility="{Binding SinResultados, Converter={StaticResource BoolVis}}"/>

                    <ItemsControl ItemsSource="{Binding Filas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1">
                                    <Grid Margin="20,0" Height="62">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" Background="{StaticResource PosAccentSoft}" Padding="4">
                                                <ContentControl Content="{Binding Producto}"
                                                                ContentTemplate="{StaticResource ImagenProducto}"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Producto.Nombre}" Style="{StaticResource Cell}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Producto.Descripcion}" FontSize="10"
                                                           Foreground="{StaticResource PosMuted}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="360"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Producto.Categoria}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Producto.Precio, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Existencia}" Style="{StaticResource Cell}"/>

                                        <!-- Estado: verde / ámbar / rojo -->
                                        <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E7F1E8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BajoStock}" Value="True">
                                                            <Setter Property="Background" Value="#F8EDDC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Agotado}" Value="True">
                                                            <Setter Property="Background" Value="#F8E4E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PosOk}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BajoStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource PosWarn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Agotado}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource PosDanger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.EsAdministrador, ElementName=vista, Converter={StaticResource BoolVis}}">
                                            <Button Style="{StaticResource GhostButton}" Padding="6" ToolTip="Editar"
                                                    Command="{Binding DataContext.EditarCommand, ElementName=vista}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="18"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="6" ToolTip="Eliminar"
                                                    Command="{Binding DataContext.EliminarCommand, ElementName=vista}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="18"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ResumenTabla}" FontSize="11" Foreground="{StaticResource PosMuted}"
                               Margin="20,14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
