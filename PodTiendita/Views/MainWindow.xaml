<ui:FluentWindow
    x:Class="PodTiendita.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PodTiendita.ViewModels"
    xmlns:views="clr-namespace:PodTiendita.Views"
    mc:Ignorable="d"
    Title="PodTiendita" Height="780" Width="1280" MinHeight="680" MinWidth="1100"
    WindowStartupLocation="CenterScreen" WindowState="Maximized"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#F5F7FA">

    <ui:FluentWindow.Resources>
        <!-- Cada ViewModel de pantalla se dibuja con su vista -->
        <DataTemplate DataType="{x:Type vm:VentasViewModel}">
            <views:VentasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistorialViewModel}">
            <views:HistorialView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
            <views:ReportesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
            <views:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductoFormViewModel}">
            <views:ProductoFormView/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="#F5F7FA">
        <ui:TitleBar Title="" VerticalAlignment="Top" Panel.ZIndex="10"/>

        <!-- Contenido a pantalla completa -->
        <Border Margin="0,32,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Menú lateral ============ -->
                <Border Grid.Column="0" Background="White" CornerRadius="0"
                        BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="30,32,0,36" FontSize="24" FontWeight="SemiBold">
                            <Run Text="Pod" Foreground="{StaticResource PosAccent}"/><Run Text="Tiendita" Foreground="{StaticResource PosDark}"/>
                        </TextBlock>

                        <StackPanel Grid.Row="1">
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="True" GroupName="nav"
                                         Command="{Binding IrAVentasCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cart24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Ventas" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         Command="{Binding IrAHistorialCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Historial" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         Command="{Binding IrAProductosCommand}"
                                         Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Productos" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsEnabled="False" ToolTip="Próximamente"
                                         Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Archive24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Inventario" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         Command="{Binding IrAReportesCommand}"
                                         Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Reportes" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="24,0,0,24">
                            <Border Height="1" Background="{StaticResource PosBorder}" Margin="0,0,24,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="0" Background="{StaticResource PosDark}">
                                    <TextBlock Text="{Binding Iniciales}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NombreUsuario}" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource PosDark}"/>
                                    <TextBlock Text="{Binding RolUsuario}" FontSize="11" Foreground="{StaticResource PosMuted}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="BtnCerrarSesion_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SignOut24" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="Cerrar sesión" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Barra superior + pantalla activa ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" Height="64" CornerRadius="0"
                            BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1">
                        <Grid Margin="30,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="8" Height="8" Fill="{StaticResource PosOk}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding NombreUsuario, StringFormat=Caja abierta · Turno de {0}}"
                                           FontSize="12" Foreground="{StaticResource PosMuted}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Reloj}" FontSize="12" Foreground="{StaticResource PosMuted}"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <!-- Campana: alertas de stock bajo -->
                                <Grid>
                                    <ToggleButton x:Name="btnAlertas" Width="38" Height="38" Cursor="Hand"
                                                  Background="Transparent" BorderThickness="0" ToolTip="Alertas de stock">
                                        <ui:SymbolIcon Symbol="Alert24" FontSize="20" Foreground="{StaticResource PosDark}"/>
                                    </ToggleButton>
                                    <Border Width="10" Height="10" CornerRadius="0" Background="{StaticResource PosDanger}"
                                            BorderBrush="White" BorderThickness="1.5" IsHitTestVisible="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                            Visibility="{Binding HayStockBajo, Converter={StaticResource BoolVis}}"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=btnAlertas, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=btnAlertas}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
                                        <Border Width="300" Background="White" CornerRadius="0" Padding="16"
                                                BorderBrush="{StaticResource PosBorder}" BorderThickness="1" Margin="12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="16" ShadowDepth="2"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="Stock bajo" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PosDark}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Todo el inventario está en orden." FontSize="12"
                                                           Foreground="{StaticResource PosMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HayStockBajo}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding StockBajo}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <TextBlock Text="{Binding Nombre}" FontSize="12"
                                                                           Foreground="{StaticResource PosDark}" TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,70,0"/>
                                                                <TextBlock Style="{StaticResource StockBadge}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding VistaActual}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
