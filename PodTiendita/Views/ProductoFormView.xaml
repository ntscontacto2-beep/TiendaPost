<UserControl
    x:Class="PodTiendita.Views.ProductoFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PodTiendita.ViewModels">

    <UserControl.Resources>
        <!-- Letra y campos grandes: el sistema lo usan personas mayores -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PosDark}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Ayuda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource PosMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,22,30,30" MaxWidth="1100" HorizontalAlignment="Stretch">

            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,4"
                    Command="{Binding CancelarCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Volver a productos" FontSize="13"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding Titulo}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource PosDark}" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding Subtitulo}" FontSize="14" Foreground="{StaticResource PosMuted}" Margin="0,4,0,20"/>

            <!-- Aviso de error -->
            <Border Background="#F8E4E2" BorderBrush="{StaticResource PosDanger}" BorderThickness="1" Padding="16,12"
                    Margin="0,0,0,16" Visibility="{Binding HayError, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Error}" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource PosDanger}" TextWrapping="Wrap"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Datos ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="28" Margin="0,0,20,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Datos del producto" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,0,0,18"/>

                        <TextBlock Text="Nombre del producto" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtNombre" Style="{StaticResource Campo}" MaxLength="100"
                                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Escríbelo como lo conoces, por ejemplo: Coca-Cola 600 ml."/>

                        <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}" Margin="0,20,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:ProductoFormViewModel.Categorias}"
                                  SelectedItem="{Binding Categoria}" FontSize="16" MinHeight="46"
                                  VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Descripción (opcional)" Style="{StaticResource Etiqueta}" Margin="0,20,0,6"/>
                        <TextBox Style="{StaticResource Campo}" MaxLength="250"
                                 Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"/>

                        <Border Height="1" Background="{StaticResource PosBorder}" Margin="0,26,0,22"/>
                        <TextBlock Text="Precio e inventario" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio de venta ($)" Style="{StaticResource Etiqueta}"/>
                                <TextBox Style="{StaticResource Campo}" MaxLength="10"
                                         Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding EtiquetaExistencia}" Style="{StaticResource Etiqueta}"/>
                                <TextBox Style="{StaticResource Campo}" MaxLength="6"
                                         Text="{Binding ExistenciaTexto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Avisar cuando queden" Style="{StaticResource Etiqueta}"/>
                                <TextBox Style="{StaticResource Campo}" MaxLength="6"
                                         Text="{Binding StockMinimoTexto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Cuando las piezas lleguen al número de &quot;Avisar cuando queden&quot;, el sistema mostrará una alerta de stock bajo."/>
                    </StackPanel>
                </Border>

                <!-- ============ Foto ============ -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Foto del producto" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PosDark}" Margin="0,0,0,16"/>

                        <!-- Vista previa -->
                        <Border Width="220" Height="220" Background="{StaticResource PosAccentSoft}"
                                BorderBrush="{StaticResource PosBorder}" BorderThickness="1" Padding="8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SinImagen, Converter={StaticResource BoolVis}}">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="48" Foreground="#9AA8B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Aún sin foto" FontSize="13" Foreground="{StaticResource PosMuted}"
                                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image Source="{Binding VistaPrevia}" Stretch="Uniform"/>
                            </Grid>
                        </Border>

                        <!-- Dos pasos: buscar en el navegador y pegar la foto copiada -->
                        <Button Style="{StaticResource AccentButton}" Margin="0,18,0,0"
                                Command="{Binding BuscarFotosEnInternetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="1. Buscar fotos en internet" FontSize="15"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineAccentButton}" Margin="0,10,0,0"
                                Command="{Binding PegarFotoCommand}">
                            <TextBlock Text="2. Pegar la foto que copié" FontSize="15"/>
                        </Button>
                        <TextBlock Text="{Binding MensajeFoto}" Style="{StaticResource Ayuda}" FontSize="13"
                                   Foreground="{StaticResource PosDark}" Margin="0,12,0,0"/>

                        <Border Height="1" Background="{StaticResource PosBorder}" Margin="0,18,0,14"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,4"
                                Command="{Binding ElegirArchivoCommand}">
                            <TextBlock Text="O elegir una foto que ya tengo en la computadora" FontSize="13"/>
                        </Button>
                        <Button Content="Quitar foto" Style="{StaticResource GhostButton}" FontSize="13"
                                Foreground="{StaticResource PosMuted}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0,4"
                                Command="{Binding QuitarImagenCommand}"
                                Visibility="{Binding HayImagen, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Botones -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineAccentButton}" Margin="0,0,12,0" MinWidth="140"
                            Command="{Binding CancelarCommand}">
                        <TextBlock Text="Cancelar" FontSize="15"/>
                    </Button>
                    <Button Content="Guardar producto" Style="{StaticResource AccentButton}" MinWidth="200" FontSize="15"
                            Command="{Binding GuardarCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
