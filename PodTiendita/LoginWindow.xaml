<ui:FluentWindow
    x:Class="PodTiendita.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="Iniciar sesión" Height="600" Width="960"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#F1F0FF">

    <Grid>
        <ui:TitleBar Title="" ShowMaximize="False" VerticalAlignment="Top" Panel.ZIndex="10"/>

        <!-- Tarjeta principal -->
        <Border Margin="40,44,40,40"
                CornerRadius="18"
                Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#7B6CF6" Opacity="0.25" BlurRadius="40" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel izquierdo con degradado -->
                <Border Grid.Column="0" CornerRadius="16" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B8E8FF" Offset="0"/>
                            <GradientStop Color="#C9B8FF" Offset="0.55"/>
                            <GradientStop Color="#A66BFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Mancha azul oscuro difuminada -->
                        <Border CornerRadius="16">
                            <Border.Background>
                                <RadialGradientBrush Center="0.2,0.5" GradientOrigin="0.2,0.5"
                                                     RadiusX="0.65" RadiusY="0.55">
                                    <GradientStop Color="#FF1B0F8C" Offset="0"/>
                                    <GradientStop Color="#CC3B2BD9" Offset="0.4"/>
                                    <GradientStop Color="#00A8D8FF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <ui:SymbolIcon Symbol="BuildingShop24" FontSize="38" Foreground="White"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="22,20,0,0"/>

                        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,28">
                            <TextBlock Text="Tu tienda, siempre contigo"
                                       Foreground="White" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="Controla tus ventas y tu inventario desde un solo lugar"
                                       Foreground="White" FontSize="24" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Formulario -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Width="300">

                    <ui:SymbolIcon Symbol="BuildingShop24" FontSize="30" Foreground="#4A3AFF"
                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Iniciar sesión" FontSize="28" FontWeight="Bold"
                               Foreground="#111111"/>
                    <TextBlock Text="Accede a PodTiendita para administrar tus ventas, productos y clientes."
                               FontSize="12" Foreground="#888888" TextWrapping="Wrap"
                               Margin="0,8,0,26"/>

                    <TextBlock Text="Usuario o correo" FontWeight="SemiBold" Foreground="#111111"
                               Margin="0,0,0,6"/>
                    <ui:TextBox x:Name="txtUsuario"
                                PlaceholderText="ejemplo@correo.com"
                                Margin="0,0,0,18"/>

                    <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="#111111"
                               Margin="0,0,0,6"/>
                    <ui:PasswordBox x:Name="txtPassword"
                                    PlaceholderText="••••••••••"
                                    RevealButtonEnabled="True"
                                    KeyDown="TxtPassword_KeyDown"/>

                    <TextBlock x:Name="lblError"
                               Foreground="#D13438"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                    <ui:Button Content="Ingresar"
                               Appearance="Primary"
                               Background="#4A3AFF"
                               Foreground="White"
                               HorizontalAlignment="Stretch"
                               Height="42"
                               Margin="0,22,0,0"
                               Click="BtnIngresar_Click">
                        <ui:Button.Effect>
                            <DropShadowEffect Color="#4A3AFF" Opacity="0.35" BlurRadius="14"
                                              ShadowDepth="4" Direction="270"/>
                        </ui:Button.Effect>
                    </ui:Button>

                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#666666"
                               Margin="0,22,0,0">
                        ¿Olvidaste tu contraseña?
                        <Hyperlink Foreground="#4A3AFF" TextDecorations="None">Recuperar</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
