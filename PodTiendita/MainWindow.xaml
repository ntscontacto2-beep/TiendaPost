<ui:FluentWindow
    x:Class="PodTiendita.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="PodTiendita" Height="780" Width="1280" MinHeight="680" MinWidth="1100"
    WindowStartupLocation="CenterScreen" WindowState="Maximized"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF3EE" Offset="0"/>
            <GradientStop Color="#FDDFD6" Offset="1"/>
        </LinearGradientBrush>
    </ui:FluentWindow.Background>

    <Grid>
        <ui:TitleBar Title="" VerticalAlignment="Top" Panel.ZIndex="10"/>

        <!-- Tarjeta principal -->
        <Border Margin="36,40,36,32" CornerRadius="24" Background="#F7F7F7">
            <Border.Effect>
                <DropShadowEffect Color="#E8A68C" Opacity="0.3" BlurRadius="40" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Menú lateral ============ -->
                <Border Grid.Column="0" Background="White" CornerRadius="24,0,0,24"
                        BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="30,32,0,36" FontSize="24" FontWeight="SemiBold">
                            <Run Text="Pod" Foreground="{StaticResource PosAccent}"/><Run Text="Tiendita" Foreground="{StaticResource PosDark}"/>
                        </TextBlock>

                        <StackPanel Grid.Row="1">
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="True" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cart24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Punto de venta" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Productos" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Receipt24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Ventas" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Historial" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{StaticResource PosBorder}" Margin="0,16,0,16"/>

                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="People24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Clientes" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Configuración" FontSize="13"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="30,0,0,30"
                                HorizontalAlignment="Left" Click="BtnCerrarSesion_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SignOut24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Cerrar sesión" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============ Catálogo ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de búsqueda -->
                    <Border Grid.Row="0" Background="White" Height="78"
                            BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1">
                        <Border Background="#F2F2F2" CornerRadius="22" Height="44" Width="420"
                                HorizontalAlignment="Left" Margin="30,0,0,0">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{StaticResource PosMuted}"
                                               HorizontalAlignment="Left" Margin="18,0,0,0"/>
                                <TextBox x:Name="txtBuscar" Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center" Margin="48,0,16,0"
                                         FontSize="13" TextChanged="TxtBuscar_TextChanged"/>
                                <TextBlock Text="Buscar producto..." IsHitTestVisible="False"
                                           Foreground="{StaticResource PosMuted}" FontSize="13"
                                           VerticalAlignment="Center" Margin="52,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Border>

                    <Grid Grid.Row="1" Margin="30,26,30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Categorías -->
                        <StackPanel x:Name="pnlCategorias" Grid.Row="0" Orientation="Horizontal"/>

                        <TextBlock x:Name="lblTitulo" Grid.Row="1" Text="Todos los productos"
                                   FontSize="20" FontWeight="Medium" Foreground="{StaticResource PosDark}"
                                   Margin="0,26,0,16"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="lstProductos">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="268" Margin="0,0,16,16" Padding="12"
                                                Background="White" CornerRadius="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="84" Height="84" CornerRadius="12"
                                                        Background="{StaticResource PosAccentSoft}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Initial}" FontSize="36" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PosAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                               Foreground="{StaticResource PosDark}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}" FontSize="14"
                                                               Foreground="{StaticResource PosAccent}" FontWeight="SemiBold"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource PosMuted}" Margin="0,6,0,0"
                                                               MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Stock, StringFormat=Stock: {0}}" FontSize="11"
                                                               Foreground="{StaticResource PosDark}" Margin="0,6,0,8"/>
                                                    <Button Content="Agregar" Style="{StaticResource OutlineAccentButton}"
                                                            Click="BtnAgregar_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============ Carrito ============ -->
                <Border Grid.Column="2" Background="White" CornerRadius="0,24,24,0"
                        BorderBrush="{StaticResource PosBorder}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Usuario -->
                        <Grid Grid.Row="0" Height="78" Margin="24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PosAccentSoft}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="{StaticResource PosAccent}"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cajero" FontSize="13" FontWeight="Medium" Foreground="{StaticResource PosDark}"/>
                                    <TextBlock Text="Caja 1" FontSize="11" Foreground="{StaticResource PosMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource PosBorder}"/>

                        <!-- Encabezado de la venta -->
                        <StackPanel Grid.Row="1" Margin="24,22,24,10">
                            <Grid>
                                <TextBlock Text="Venta" FontSize="20" FontWeight="Medium" Foreground="{StaticResource PosDark}"/>
                                <TextBlock x:Name="lblFolio" Text="Folio #1001" FontSize="12"
                                           Foreground="{StaticResource PosMuted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <RadioButton x:Name="rbEfectivo" Content="Efectivo" Style="{StaticResource PillDark}"
                                             GroupName="pago" IsChecked="True"/>
                                <RadioButton x:Name="rbTarjeta" Content="Tarjeta" Style="{StaticResource PillDark}"
                                             GroupName="pago"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Líneas del carrito -->
                        <Grid Grid.Row="2" Margin="24,0">
                            <TextBlock x:Name="lblVacio" Text="Agrega productos para iniciar la venta"
                                       Foreground="{StaticResource PosMuted}" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="lstCarrito">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,12" BorderBrush="{StaticResource PosBorder}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="56" Height="56" CornerRadius="10"
                                                            Background="{StaticResource PosAccentSoft}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Product.Initial}" FontSize="22" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PosAccent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Product.Name}" FontSize="13"
                                                                   Foreground="{StaticResource PosDark}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Product.Price, StringFormat={}{0:C2} c/u}" FontSize="11"
                                                                   Foreground="{StaticResource PosMuted}" Margin="0,2,0,8"/>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}" FontSize="13"
                                                                       FontWeight="Medium" Foreground="{StaticResource PosDark}"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="−" Style="{StaticResource RoundStepper}"
                                                                        Click="BtnMenos_Click"/>
                                                                <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center"
                                                                           VerticalAlignment="Center" FontSize="13"
                                                                           Foreground="{StaticResource PosDark}"/>
                                                                <Button Content="+" Style="{StaticResource RoundStepper}"
                                                                        Click="BtnMas_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Totales -->
                        <StackPanel Grid.Row="3" Margin="24,12,24,24">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Artículos" FontSize="13" Foreground="{StaticResource PosMuted}"/>
                                <TextBlock x:Name="lblArticulos" Text="0" FontSize="13" HorizontalAlignment="Right"
                                           Foreground="{StaticResource PosDark}"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource PosBorder}" Margin="0,4,0,12"/>
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="Total" FontSize="15" FontWeight="Medium" Foreground="{StaticResource PosDark}"/>
                                <TextBlock x:Name="lblTotal" Text="$0.00" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" Foreground="{StaticResource PosAccent}"/>
                            </Grid>
                            <Button x:Name="btnCobrar" Content="Cobrar" Style="{StaticResource AccentButton}"
                                    IsEnabled="False" Click="BtnCobrar_Click"/>
                            <Button Content="Vaciar venta" Style="{StaticResource GhostButton}" FontSize="12"
                                    Foreground="{StaticResource PosMuted}" HorizontalAlignment="Center"
                                    Margin="0,10,0,0" Padding="8,4" Click="BtnVaciar_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
